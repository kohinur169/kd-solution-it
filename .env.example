# path: .env.example
#
# KD SOLUTION IT - environment contract.
#
# Generated from lib/env/manifest.ts by `npm run env:example`. Do not edit by hand:
# `npm run check:env` fails when this file and the manifest disagree, and that check runs
# inside `npm run verify`.
#
# Every value below is a placeholder, never a real credential. Copy this file to
# .env.local for development and replace the placeholders there. .env.local is git
# ignored, and no real value belongs in this repository.
#
# The server validates this contract at boot through lib/env/server.ts and refuses to
# start when a required variable is missing or malformed.

# NODE_ENV
# Runtime mode of the process. development, test or production; the hosting platform sets production.
# Required in every environment.
NODE_ENV=development

# APP_URL
# Canonical HTTPS URL of this environment. Used for absolute links in email, payment pages and tokenized client links.
# Required in every environment.
APP_URL=https://app.example.com

# DATABASE_URL (secret, never commit a real value)
# PostgreSQL connection string of the Supabase project for this environment, used by migrations and server queries.
# Required in every environment.
DATABASE_URL=postgresql://user:password@db.example.com:5432/postgres

# SUPABASE_URL
# Supabase project URL of this environment.
# Required in every environment.
SUPABASE_URL=https://project-ref.supabase.co

# SUPABASE_ANON_KEY
# Supabase anonymous key. Public by design but still only read on the server and never committed.
# Required in every environment.
SUPABASE_ANON_KEY=replace-with-the-supabase-anonymous-key

# SUPABASE_SERVICE_ROLE_KEY (secret, never commit a real value)
# Supabase service role key. Server only, bypasses row level security, never reachable from the browser.
# Required in every environment.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-supabase-service-role-key

# ENCRYPTION_MASTER_KEY (secret, never commit a real value)
# AES-256-GCM key that encrypts provider keys, email secrets and stored files. Custodian is the CEO; key material exists only here.
# Required in every environment.
ENCRYPTION_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# AUDIT_SIGNING_KEY (secret, never commit a real value)
# Ed25519 signing key seed for the hash-chained append-only audit log and its Merkle root export.
# Required in every environment.
AUDIT_SIGNING_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# STORAGE_PROVIDER
# Active object storage adapter. Files are encrypted before upload either way; server local disk is never used.
# Optional. Default: supabase.
STORAGE_PROVIDER=supabase

# S3_BUCKET
# Amazon S3 bucket that holds encrypted files when the S3 adapter is active.
# Required when STORAGE_PROVIDER is "s3".
S3_BUCKET=kd-solution-it-files

# S3_REGION
# Amazon S3 region of that bucket.
# Required when STORAGE_PROVIDER is "s3".
S3_REGION=us-east-1

# S3_ACCESS_KEY_ID (secret, never commit a real value)
# Access key id of the S3 user that may write and read the file bucket.
# Required when STORAGE_PROVIDER is "s3".
S3_ACCESS_KEY_ID=replace-with-the-s3-access-key-id

# S3_SECRET_ACCESS_KEY (secret, never commit a real value)
# Secret access key of that S3 user.
# Required when STORAGE_PROVIDER is "s3".
S3_SECRET_ACCESS_KEY=replace-with-the-s3-secret-access-key

# SENTRY_DSN
# Sentry project DSN for server and client error reporting with release tracking. Monitoring is off while empty.
# Optional.
SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000

# LOG_LEVEL
# Minimum severity written by the structured logger: debug, info, warn or error.
# Optional. Default: info.
LOG_LEVEL=info

# NEXT_PUBLIC_TURNSTILE_SITE_KEY
# Cloudflare Turnstile site key for the signup, login and password reset widgets. Public by design; the secret key stays in the database settings.
# Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-the-turnstile-site-key
